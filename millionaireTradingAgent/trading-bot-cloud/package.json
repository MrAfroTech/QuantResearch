{
  "name": "the305",
  "version": "1.0.0",
  "description": "The305 — options trading bot with Tradier signals and Tastytrade execution",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "build": "npm run build:frontend",
    "build:frontend": "vite build",
    "build:vercel": "vite build",
    "dev:frontend": "vite --port 5173",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "register:telegram-webhook": "node scripts/register-telegram-webhook.js",
    "test": "node --test tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "test:stop-loss": "node --test tests/stop-loss/**/*.test.js",
    "test:ci": "node --test --test-reporter=spec tests/**/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@libsql/client": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
