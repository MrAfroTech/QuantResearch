{
  "version": 2,
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/api/cron/poll",
      "schedule": "*/5 * * * 1-5"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "api/status.js": {
      "maxDuration": 60
    },
    "api/mode.js": {
      "maxDuration": 30
    },
    "api/sms/webhook.js": {
      "maxDuration": 30
    },
    "api/cron/poll.js": {
      "maxDuration": 300
    }
  }
}
