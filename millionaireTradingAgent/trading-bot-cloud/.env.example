# Tastytrade (default: sandbox)
TASTYTRADE_USERNAME=
TASTYTRADE_PASSWORD=
TASTYTRADE_ACCOUNT_NUMBER=
TASTYTRADE_SANDBOX=true

# Tradier market data (default: sandbox)
TRADIER_API_TOKEN=
TRADIER_SANDBOX=true

# Watchlist (comma-separated symbols)
WATCHLIST=SHOP,NFLX,TOST,DUOL,PII,PTON,PLTM,RIOT,SOUN,RIVN,LYFT,UBER,HOOD,PLTR,SOFI,^VIX,AI,JBLU

# Supabase Session Pooler connection string (Settings > Database > Connect > Direct tab > Session pooler) — required for persistent connections from Railway.
SUPABASE_DB_URL=

# Auto-set by Vercel Cron when configured in project settings
CRON_SECRET=

# Optional — override auto-detected base URL for OAuth redirects
BASE_URL=

