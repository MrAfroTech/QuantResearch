SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=
SCHWAB_ACCOUNT_HASH=
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=
ETRADE_REDIRECT_URI=
ANTHROPIC_API_KEY=
# Ladder broker-side stop orders (0DTE: ORB, Premarket, EMA/VWAP). Off by default — enable after paper validation.
LADDER_BROKER_STOP_ENABLED=false
# Optional override — comma-separated subset: emavwap, orb, premarket (default: all three)
# LADDER_BROKER_STOP_STRATEGIES=emavwap,orb,premarket
# stop_market (default) | stop_limit
LADDER_STOP_ORDER_TYPE=stop_market

PAPER_TRADING=true
PORT=3001

# Tastytrade sandbox (cert API) — OAuth2 is required for sandbox API access
TASTYTRADE_SANDBOX_CLIENT_ID=
TASTYTRADE_SANDBOX_CLIENT_SECRET=
TASTYTRADE_SANDBOX_REFRESH_TOKEN=
# Optional; default "read trade" (matches @tastytrade/api SDK)
# TASTYTRADE_OAUTH_SCOPES=read trade
# Legacy sandbox login (fallback if OAuth vars not set)
TASTYTRADE_USERNAME=
TASTYTRADE_PASSWORD=
TASTYTRADE_ACCOUNT_NUMBER=
TASTYTRADE_SANDBOX=true

# Tastytrade live account (required when a strategy environment is set to live)
# Preferred: OAuth2 (same pattern as sandbox)
TASTYTRADE_LIVE_CLIENT_ID=
TASTYTRADE_LIVE_CLIENT_SECRET=
TASTYTRADE_LIVE_REFRESH_TOKEN=
TASTYTRADE_LIVE_ACCOUNT_NUMBER=
# Alias accepted for account number:
# TASTYTRADE_LIVE_ACCOUNT=
# Legacy fallbacks (only if OAuth live vars are not set):
TASTYTRADE_LIVE_USERNAME=
TASTYTRADE_LIVE_PASSWORD=
TASTYTRADE_LIVE_TOKEN=

# Tradier market data (default: sandbox)
TRADIER_API_TOKEN=
TRADIER_SANDBOX=true

# Watchlist (comma-separated symbols) — overrides default list in backend/defaultWatchlist.js
WATCHLIST=SHOP,NFLX,TOST,DUOL,PTON,PLTM,RIOT,SOUN,RIVN,LYFT,UBER,HOOD,PLTR,SOFI,AI,JBLU,SPY,SPX,QQQ,IWM

# Supabase Session Pooler connection string (Settings > Database > Connect > Session pooler)
SUPABASE_DB_URL=

# Railway: scheduler auto-starts when RAILWAY_* env is present.
# Local dev: set RUN_SCHEDULER=true to enable polling.
RUN_SCHEDULER=true

# Railway — Vercel dashboard URL(s) allowed to call this API (comma-separated)
FRONTEND_URL=https://miami-trader.mauricethefirst.com,http://localhost:5173

# Dashboard write controls (mode toggles). Keep false until auth is implemented.
DASHBOARD_CONTROLS_ENABLED=false

# Live risk — daily loss circuit breaker uses 30% of session-start cash balance (code constant).
# Live budget splits actual Tastytrade live cash balance evenly across strategies with environment=live.
# Entry gate is fail-closed: if live balance/risk sync fails, new live entries are blocked (paper unchanged).

# Vercel build only — Railway public URL for the dashboard
# Example: https://your-service.up.railway.app
VITE_API_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — override auto-detected base URL for OAuth redirects
BASE_URL=
